<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <!-- App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView android:id="@+id/btnBack"
            android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_back"/>

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Manage Categories"
            android:textSize="18sp" android:textStyle="bold"
            android:textColor="#1A1A2E" android:gravity="center"/>

        <ImageView android:id="@+id/btnArchive"
            android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_archive"/>
    </LinearLayout>

    <!-- STICKY Popup Preview -->
    <LinearLayout
        android:id="@+id/popupPreviewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_popup_preview"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:elevation="3dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="POPUP PREVIEW"
            android:textSize="11sp"
            android:textColor="#9CA3AF"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"/>

        <!-- Collapsed chips row -->
        <LinearLayout
            android:id="@+id/previewCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>

        <!-- Expanded grid -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/previewExpanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Scrollable categories list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Active Categories"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="#1A1A2E"/>

                <TextView android:id="@+id/btnAddNew"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="+ Add New"
                    android:textSize="13sp" android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:background="@drawable/bg_filter_active"
                    android:paddingStart="16dp" android:paddingEnd="16dp"/>
            </LinearLayout>

            <!-- Category list -->
            <LinearLayout
                android:id="@+id/categoryListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- Hint -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="24dp">

                <ImageView
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:src="@drawable/ic_settings"
                    android:alpha="0.3"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Drag and drop categories to reorder them in your main dashboard and quick-add bars."
                    android:textSize="13sp" android:textColor="#9CA3AF"
                    android:gravity="center" android:layout_marginTop="12dp"
                    android:paddingStart="32dp" android:paddingEnd="32dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation -->
    <include layout="@layout/layout_bottom_nav"/>

</LinearLayout>
