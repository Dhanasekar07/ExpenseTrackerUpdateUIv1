<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <!-- App Bar -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:visibility="gone"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Transactions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"/>
    </LinearLayout>

    <!-- Search bar (hidden by default) -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_search_bar"
            android:hint="Search transactions..."
            android:textSize="14sp"
            android:textColor="#1A1A2E"
            android:textColorHint="#9CA3AF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"/>
    </LinearLayout>

    <!-- Filter tabs (STICKY) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:elevation="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/tabDay"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Day" android:textSize="13sp" android:textColor="#FFFFFF"
                android:gravity="center" android:background="@drawable/bg_filter_active"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:layout_marginEnd="8dp"/>

            <TextView android:id="@+id/tabWeek"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Week" android:textSize="13sp" android:textColor="#6B7280"
                android:gravity="center" android:background="@drawable/bg_filter_inactive"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:layout_marginEnd="8dp"/>

            <TextView android:id="@+id/tabMonth"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Month" android:textSize="13sp" android:textColor="#6B7280"
                android:gravity="center" android:background="@drawable/bg_filter_inactive"
                android:paddingStart="20dp" android:paddingEnd="20dp"
                android:layout_marginEnd="8dp"/>

            <TextView android:id="@+id/tabCustom"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Custom" android:textSize="13sp" android:textColor="#6B7280"
                android:gravity="center" android:background="@drawable/bg_filter_inactive"
                android:paddingStart="20dp" android:paddingEnd="20dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Transaction list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/transactionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- Bottom Navigation -->
    <include layout="@layout/layout_bottom_nav"/>

</LinearLayout>
