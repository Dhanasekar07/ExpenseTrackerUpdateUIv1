<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorSecondary">@color/brand_green_light</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="AppTheme.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_green_light</item>
        <item name="colorPrimaryVariant">@color/brand_green</item>
        <item name="colorSecondary">@color/brand_green_pale</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <!-- Card style -->
    <style name="PremiumCard">
        <item name="android:background">@color/bg_card</item>
        <item name="android:elevation">2dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Button styles -->
    <style name="GreenButton">
        <item name="android:background">@drawable/bg_button_green</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="FilterTab">
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
</resources>
